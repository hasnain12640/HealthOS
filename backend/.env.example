ENVIRONMENT=development

# SQLite for local development; for Postgres use:
# DATABASE_URL=postgresql://user:password@host:5432/healthos
DATABASE_URL=sqlite:///./healthos.db

AI_PROVIDER=mock
QWEN_API_KEY=your_qwen_api_key_here
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Authentication — generate a secure key with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-generate-with-python-secrets-token-urlsafe-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Demo account — leave DEMO_PASSWORD empty to skip seeding
DEMO_EMAIL=demo@healthos.pk
DEMO_PASSWORD=
SEED_DEMO_DATA=true

# Comma-separated origins; production must list the exact frontend domain
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
